# Root-level tooling scripts (Blender, asset pipeline) — not the backend app.
# Backend env vars live in backend/.env.example.

# add_shape_keys.py — Blender background script that adds ARKit shape keys to a GLB avatar.
# Optional: defaults to frontend/public/models/fashion_girl_asian_girl.glb if unset.
GLB_IN=./frontend/public/models/fashion_girl_asian_girl.glb
GLB_OUT=./frontend/public/models/fashion_girl_asian_girl.glb
